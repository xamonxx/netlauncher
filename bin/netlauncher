#!/usr/bin/env bash
# netlauncher - Smart terminal launcher & automation untuk tool jaringan (authorized use only)
# Version: 2.1.0
set -uo pipefail
umask 077
export PATH="$HOME/.local/bin:$PATH"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
LIB_DIR="$REPO_DIR/lib"

# shellcheck source=../lib/core.sh
source "$LIB_DIR/core.sh"
# shellcheck source=../lib/ui.sh
source "$LIB_DIR/ui.sh"
# shellcheck source=../lib/runner.sh
source "$LIB_DIR/runner.sh"
# shellcheck source=../lib/smart.sh
source "$LIB_DIR/smart.sh"
# shellcheck source=../lib/snippets.sh
source "$LIB_DIR/snippets.sh"
# shellcheck source=../lib/wordlists.sh
source "$LIB_DIR/wordlists.sh"
# shellcheck source=../lib/knowledge.sh
source "$LIB_DIR/knowledge.sh"
# shellcheck source=../lib/flow.sh
source "$LIB_DIR/flow.sh"
# shellcheck source=../lib/recipes.sh
source "$LIB_DIR/recipes.sh"
# shellcheck source=../lib/menu.sh
source "$LIB_DIR/menu.sh"
# shellcheck source=../lib/doctor.sh
source "$LIB_DIR/doctor.sh"

trap 'ui_cleanup' EXIT INT TERM

main_menu_loop() {
  local choice
  ui_splash
  while true; do
    choice="$(main_menu)" || exit 0
    case "$choice" in
      quit|"") exit 0 ;;
      search) global_search_menu ;;
      snippets) snippets_menu ;;
      knowledge) knowledge_menu ;;
      workspace) workspace_menu ;;
      flow) flow_ui ;;
      automation) automation_menu ;;
      favorit) favorites_menu ;;
      riwayat) history_menu ;;
      wordlist) wordlist_menu ;;
      resep) recipes_menu ;;
      theme) theme_menu ;;
      doctor) doctor; pause ;;
      update) do_update ;;
      help) show_help ;;
      *) category_menu "$choice" ;;
    esac
  done
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-anim) NO_ANIM=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --theme)
        [ -n "${2:-}" ] || die "Gunakan: --theme <cyber|tokyo|emerald|amber>"
        NETLAUNCHER_THEME="$2"
        shift 2
        ;;
      *) break ;;
    esac
  done

  case "${1:-}" in
    --preview-*) FORCE_COLOR=1 ;;
  esac

  ensure_dirs
  load_theme
  load_workspace

  case "${1:-}" in
    "")
      require_fzf
      main_menu_loop
      ;;
    search)
      require_fzf
      global_search_menu
      ;;
    examples|snippets)
      require_fzf
      snippets_menu "${2:-}"
      ;;
    guide)
      if [ -n "${2:-}" ]; then
        if [ -t 0 ] && [ -t 1 ]; then
          require_fzf
          knowledge_menu "$2"
        else
          knowledge_render_guide "$2"
        fi
      else
        require_fzf
        knowledge_menu
      fi
      ;;
    flags)
      require_fzf
      if [ -n "${2:-}" ]; then
        knowledge_flag_builder "$2"
      else
        knowledge_menu
      fi
      ;;
    flow)
      shift
      flow_cli "$@"
      ;;
    workspace)
      shift
      workspace_cli "$@"
      ;;
    automation)
      require_fzf
      automation_menu
      ;;
    logs)
      require_fzf
      logs_menu
      ;;
    theme)
      if [ -n "${2:-}" ]; then
        case "$2" in
          cyber|tokyo|emerald|amber) save_theme "$2" "$ANIM"; ok "Tema diubah ke: $2" ;;
          *) die "Tema tidak dikenal: $2 (pilih: cyber, tokyo, emerald, amber)" ;;
        esac
      else
        require_fzf
        theme_menu
      fi
      ;;
    help) show_help ;;
    doctor) doctor ;;
    selftest) selftest ;;
    lint) lint ;;
    list) list_tools "${2:-table}" ;;
    wordlists)
      shift
      if [ "${1:-}" = "refresh" ]; then
        wordlist_refresh
      else
        require_fzf
        wordlist_menu
      fi
      ;;
    update) do_update ;;
    tool)
      shift
      [ -n "${1:-}" ] || { err "Gunakan: netlauncher tool <id> [argumen]"; exit 1; }
      run_tool "$@"
      ;;
    recipe)
      shift
      [ -n "${1:-}" ] || { err "Gunakan: netlauncher recipe <nama>"; exit 1; }
      run_recipe "$1"
      ;;
    --preview-tool) preview_tool "${2:-}" ;;
    --preview-category) preview_category "${2:-}" ;;
    --preview-wordlist) preview_wordlist "${2:-}" ;;
    --preview-recipe) preview_recipe "${2:-}" ;;
    --preview-snippet) preview_snippet "${2:-}" ;;
    --preview-automation) preview_automation "${2:-}" ;;
    --preview-guide) preview_guide "${2:-}" ;;
    --preview-flag) preview_flag "${2:-}" "${3:-}" ;;
    --preview-flow) preview_flow "${2:-}" ;;
    --preview-log) preview_log "${2:-}" ;;
    --preview-theme) preview_theme "${2:-}" ;;
    --preview-global) preview_global "${2:-}" ;;
    --preview-history) preview_history "${2:-}" ;;
    --version|-v) printf '%s %s\n' "$APP_NAME" "$VERSION" ;;
    --help|-h) print_cli_help ;;
    *)
      err "Perintah tidak dikenal: $1"
      print_cli_help
      exit 1
      ;;
  esac
}

main "$@"
